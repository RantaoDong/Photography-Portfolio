---
import { getImage } from 'astro:assets';
import ColorPathExplorer from '../../components/ColorPathExplorer.astro';
import type { OverallColorMatchFeatures } from '../../color/color-types.ts';
import { getImages } from '../../data/imageStore.ts';
import generatedFeatures from '../../generated/photo-color-features.json';
import MainLayout from '../../layouts/MainLayout.astro';

const images = await getImages();
const photos = await Promise.all(
	images.flatMap((image) => {
		const features = generatedFeatures.photos[image.id];
		if (!features) return [];
		return [
			(async () => {
				const landscape = image.src.width >= image.src.height;
				const maximum = 1440;
				const optimized = await getImage({
					src: image.src,
					...(landscape ? { width: maximum } : { height: maximum }),
					format: 'webp',
					quality: 82,
				});
				const scale = Math.min(1, maximum / Math.max(image.src.width, image.src.height));
				const matchingFeatures: OverallColorMatchFeatures = {
					averageLab: features.averageLab as [number, number, number],
					dominantColors: features.dominantColors.map((color) => ({
						lab: color.lab as [number, number, number],
						proportion: color.proportion,
					})),
					hueHistogram: features.hueHistogram,
					neutralProportion: features.neutralProportion,
					toneStrength: features.toneStrength,
					neutralStrength: features.neutralStrength,
				};
				return {
					id: image.id,
					src: optimized.src,
					width: Math.round(image.src.width * scale),
					height: Math.round(image.src.height * scale),
					alt: image.title || 'Photograph',
					features: matchingFeatures,
				};
			})(),
		];
	}),
);
---

<MainLayout>
	<ColorPathExplorer {photos} />
</MainLayout>
