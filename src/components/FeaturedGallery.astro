---
import PhotoGrid from './PhotoGrid.astro';
import { getImages } from '../data/imageStore';

const images = await getImages({ featuredOnly: true });
---

<div class="max-w-2xl mx-auto text-center mb-16">
	<h2 class="text-3xl md:text-4xl font-bold mb-4">Featured Works</h2>
</div>
<div class="p-4">
	<PhotoGrid images={images} reorderWithinGroup />
</div>
